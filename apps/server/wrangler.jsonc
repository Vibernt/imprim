{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  // A template. The top level serves `wrangler dev`; "staging" and "production" below hold placeholders.
  // To deploy, copy this file to wrangler.local.jsonc (gitignored), put in your own hosts, database ids and queue
  // names, and pass it to every command (docs/DEPLOY.md):
  //   wrangler deploy --config wrangler.local.jsonc --env staging
  // Realms (issuer hosts, branding, provider credentials, admins) live in D1, not here: see docs/REALMS.md.
  // Each realm host is added to the environment's "routes" as a custom domain.
  "name": "imprim",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-04",
  // Back-channel events go to relying parties over the public internet, so a relying party on this account's
  // workers.dev subdomain is reached (without this flag Cloudflare refuses such subrequests with error 1042).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // Avoid invocation records containing OAuth callback query credentials. Application logs are structured/redacted.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // Secrets, never vars: SEALING_KEY (64 hex chars) and whatever secret names each realm's config references
  // (for the default realm: TURNSTILE_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET).
  "vars": {},
  "d1_databases": [{ "binding": "DB", "database_name": "imprim", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
        { "name": "AGENT_LIMITER", "namespace_id": "1003", "simple": { "limit": 1200, "period": 60 } }
  ],
  "queues": {
    "producers": [{ "binding": "LOGOUT_QUEUE", "queue": "imprim-logout" }],
    "consumers": [{ "queue": "imprim-logout", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "imprim-logout-dlq" }]
  },
  "triggers": { "crons": ["* * * * *"] },
  // The Fire design system (public/fire: CSS, ES modules, fonts) is served as static files before the Worker runs.
  // Any other path falls through to the Worker. public/_headers sets their security headers.
  "assets": { "directory": "public" },
  "env": {
    // Every release runs here first (docs/DEPLOY.md). Email-link sign-in only until staging OAuth callbacks exist.
    "staging": {
      "name": "imprim-staging",
      "routes": [{ "pattern": "id-staging.example.com", "custom_domain": true }],
      "vars": {},
      "d1_databases": [{ "binding": "DB", "database_name": "imprim-staging", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "5201", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "5202", "simple": { "limit": 120, "period": 60 } },
        { "name": "AGENT_LIMITER", "namespace_id": "5203", "simple": { "limit": 1200, "period": 60 } }
      ],
      "queues": {
        "producers": [{ "binding": "LOGOUT_QUEUE", "queue": "imprim-staging-logout" }],
        "consumers": [{ "queue": "imprim-staging-logout", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "imprim-staging-logout-dlq" }]
      },
      "triggers": { "crons": ["* * * * *"] }
    },
    "production": {
      "name": "imprim",
      "routes": [{ "pattern": "id.example.com", "custom_domain": true }],
      // Read by the default realm's config as {"env":"EMAIL_FROM"} and {"env":"TURNSTILE_SITE_KEY"}.
      "vars": { "EMAIL_FROM": "signin@example.com", "TURNSTILE_SITE_KEY": "your-turnstile-site-key" },
      "d1_databases": [{ "binding": "DB", "database_name": "imprim", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "5101", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "5102", "simple": { "limit": 120, "period": 60 } },
        { "name": "AGENT_LIMITER", "namespace_id": "5103", "simple": { "limit": 1200, "period": 60 } }
      ],
      "queues": {
        "producers": [{ "binding": "LOGOUT_QUEUE", "queue": "imprim-production-logout" }],
        "consumers": [{ "queue": "imprim-production-logout", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "imprim-production-logout-dlq" }]
      },
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
