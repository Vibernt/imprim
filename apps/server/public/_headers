# Static files of the Fire design system. Only CSS, JavaScript modules, SVG and fonts live under public/.
# Browsers may keep a copy but must check it on every use (a cheap 304), so a release that changes the markup
# never meets an older stylesheet or module.
/fire/*
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate
/fire/*.svg
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox
# Imprim's own browser modules: the shell, the one-time-code field and the admin branding editor.
/imprim/*
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate
/imprim/*.svg
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox

# Vite content hashes change when these bytes change. The shell is served by the Worker with no-store.
/ui/static/*
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=31536000, immutable
